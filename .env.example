# From https://discord.com/developers/applications -> your app
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Right-click in Discord with Developer Mode on -> "Copy Server ID" / "Copy Channel ID"
DISCORD_GUILD_ID=
TASK_ALERTS_CHANNEL_ID=

# Filled in automatically when you add Neon Postgres from the Vercel Marketplace
DATABASE_URL=

# Any long random string. Vercel sends it with each cron call so strangers can't trigger reminders.
CRON_SECRET=

# Optional. Defaults to America/New_York
TIMEZONE=America/New_York
